# SwiftServe Frontend environment config
# Copy this file to ".env" and adjust as needed.

# Base URL of the Spring Boot backend REST API.
# Defaults to http://localhost:8080/api/v1 when not set.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# WebSocket (STOMP over SockJS) handshake URL for live order tracking.
# If omitted, it is derived from VITE_API_BASE_URL by stripping /api/v1 and
# appending /ws (e.g. http://localhost:8080/ws).
# VITE_WS_URL=http://localhost:8080/ws
